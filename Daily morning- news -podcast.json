              "id": "86fe62e7-cc8e-4d68-bb1b-767ac06ed696",
              "name": "=broadcast_script",
              "value": "={{ \"🎙️ GOOD MORNING TECH NEWS - \" + $now.format('DD MMM YYYY') + \"\\n\\n\" + ($json.rss?.channel?.[0]?.item || $json.rss?.channel?.item || []).slice(0,5).map((x,i) => `${i+1}. ${typeof x.title === 'string'? x.title : (x.title?.[0] || 'No Title')}`).join('\\n\\n') + \"\\n\\nStay tuned for more!\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        896,
        0
      ],
      "id": "6088df6a-990d-4030-b92d-fe249535693c",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet text = item.podcast_script || item.title || item.summary || item.description || \"Tech news update\";\ntext = text.toString().slice(0, 180).replace(/[^a-zA-Z0-9\\s.,]/g, \" \");\n\nconst url = 'https://translate.google.com/translate_tts?ie=UTF-8&q=' + encodeURIComponent(text) + '&tl=en&client=tw-ob';\n\nconst buffer = await this.helpers.httpRequest({\n  method: 'GET',\n  url: url,\n  encoding: 'arraybuffer',\n  headers: {\n    'User-Agent': 'Mozilla/5.0'\n  }\n});\n\nreturn [{\n  json: item,\n  binary: {\n    data: {\n      data: Buffer.from(buffer).toString('base64'),\n      mimeType: 'audio/mpeg',\n      fileName: 'news.mp3'\n    }\n  }\n}];\n"
      },
